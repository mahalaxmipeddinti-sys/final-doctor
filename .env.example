# GenomeGuard AI — Environment Variables Configuration

# 1. Supabase Project Configuration (Project Settings -> API)
# Required for user authentication, database persistence, and profile management
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Optional server-side service role key (for privileged backend admin tasks only)
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# 2. Gemini Multimodal API (Optional - for multimodal lab report parsing)
GEMINI_API_KEY=""

# 3. Application Port & Environment
PORT=3000
NODE_ENV="development"
